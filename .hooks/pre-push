#!/usr/bin/env bash
# Composition runner: dispatch pre-push.d/ in filename order. git pipes the ref
# list on stdin once -> capture to a tempfile and replay it to each check.
set -e
ROOT="$(git rev-parse --show-toplevel)"; export ROOT
tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
cat > "$tmp"
for s in "$ROOT"/.hooks/pre-push.d/*; do [[ -x "$s" ]] && "$s" "$@" < "$tmp"; done
exit 0
