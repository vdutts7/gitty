#!/usr/bin/env bash
# Composition runner: dispatch every executable in pre-commit.d/ in filename order.
# Write-once; never regenerated. A check blocks by exiting non-zero (set -e); an
# empty dir is a no-op sealed by exit 0. No append, no glob-miss trap.
set -e
ROOT="$(git rev-parse --show-toplevel)"; export ROOT
for s in "$ROOT"/.hooks/pre-commit.d/*; do [[ -x "$s" ]] && "$s" "$@"; done
exit 0
