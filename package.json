{
  "name": "@vd7/gitty",
  "version": "0.6.20",
  "description": "snapshot checkpoint CLI: gitty + gittysnap + gittyunion (content first)",
  "bin": {
    "gitty": "bin/gitty.sh",
    "gittylfs": "bin/gittylfs.sh",
    "gittyembedded": "bin/gittyembedded.sh",
    "gittyhealth": "bin/gittyhealth.sh",
    "gittyunion": "bin/gittyunion.sh",
    "gittysnap": "bin/gittysnap.sh"
  },
  "files": [
    "README.md",
    "bin"
  ],
  "scripts": {
    "test": "zsh tests/hook-extension.smoke.sh && zsh tests/hook-extension-prepush.smoke.sh && zsh tests/hook-extension-edge.smoke.sh && zsh tests/install-hooks.smoke.sh && bash tests/install-hooks.unit.sh && bash tests/npm-tarball.smoke.sh && bash tests/drip-parser.regression.sh && zsh tests/drip-targeted-retry.smoke.sh && zsh tests/additive-integrate.smoke.sh && zsh tests/runner-shape.regression.sh && bash tests/handoff-md.regression.sh && bin/gitty.sh --help",
    "test:readme-badges": "zsh tests/readme-contact-badges.smoke.sh",
    "test:partial": "zsh tests/partial-commit.smoke.sh",
    "test:integrate": "zsh tests/additive-integrate.smoke.sh",
    "test:union": "zsh tests/ndjson-union.smoke.sh",
    "test:snap": "zsh tests/gittysnap.smoke.sh",
    "test:hook-extension": "zsh tests/hook-extension.smoke.sh",
    "test:readme": "zsh tests/readme-contact-badges.smoke.sh",
    "test:install-hooks": "zsh tests/install-hooks.smoke.sh",
    "test:drip-parser": "bash tests/drip-parser.regression.sh",
    "test:prepush": "zsh tests/hook-extension-prepush.smoke.sh",
    "test:edge": "zsh tests/hook-extension-edge.smoke.sh",
    "test:tarball": "bash tests/npm-tarball.smoke.sh"
  },
  "keywords": [
    "git",
    "commit",
    "push",
    "cli",
    "workflow",
    "lfs",
    "submodule",
    "health-check",
    "merge-driver",
    "ndjson",
    "snapshot",
    "sync",
    "solo-dev"
  ],
  "author": "vdutts7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdutts7/gitty.git"
  },
  "homepage": "https://github.com/vdutts7/gitty#readme",
  "engines": {
    "node": ">=14.0.0"
  }
}
